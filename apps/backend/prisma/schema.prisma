  status ConciergeBookingState @default(PROPOSED)
  contact Json?
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  clinic VeterinaryClinic @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  conversation ConciergeConversation @relation(fields: [conversationId, clinicId], references: [id, clinicId], onDelete: Cascade)
  @@unique([id, clinicId])
  @@index([clinicId, status, createdAt])
}
model ConciergeUsage {
  id String @id @default(uuid()) @db.Uuid
  clinicId String @db.Uuid
  conversationId String @db.Uuid
  model String @db.VarChar(100)
  state ConciergeUsageState @default(RESERVED)
