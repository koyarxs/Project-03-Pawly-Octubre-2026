generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  ADMIN
  VETERINARIAN
  RECEPTIONIST
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  name            String             @db.VarChar(120)
  email           String             @db.VarChar(254)
  normalizedEmail String             @unique @db.VarChar(254)
  passwordHash    String             @db.Text
  status          UserStatus         @default(ACTIVE)
  emailVerifiedAt DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(3)
  memberships     ClinicMembership[]
  sessions        Session[]
}

model VeterinaryClinic {
  id          String             @id @default(uuid()) @db.Uuid
  name        String             @db.VarChar(160)
  slug        String             @unique @db.VarChar(100)
  status      ClinicStatus       @default(ACTIVE)
  timezone    String             @default("America/Santiago") @db.VarChar(100)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)
  memberships ClinicMembership[]
  tutors      Tutor[]
  patients    Patient[]
}

model ClinicMembership {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  clinicId  String           @db.Uuid
  role      Role
  status    MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  clinic    VeterinaryClinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, clinicId])
  @@index([clinicId, status, role])
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  lastSeenAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@index([expiresAt])
}

enum TutorStatus {
  ACTIVE
  ARCHIVED
}

enum PatientStatus {
  ACTIVE
  DECEASED
  ARCHIVED
}

enum Species {
  DOG
  CAT
  BIRD
  RABBIT
  RODENT
  REPTILE
  HORSE
  OTHER
}

enum PatientSex {
  FEMALE
  MALE
  UNKNOWN
}

model Tutor {
  id         String           @id @default(uuid()) @db.Uuid
  clinicId   String           @db.Uuid
  firstName  String           @db.VarChar(100)
  lastName   String           @db.VarChar(100)
  email      String?          @db.VarChar(254)
  phone      String           @db.VarChar(32)
  address    String?          @db.VarChar(500)
  notes      String?          @db.VarChar(2000)
  status     TutorStatus      @default(ACTIVE)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  clinic     VeterinaryClinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  patients   PatientTutor[]

  @@unique([id, clinicId])
  @@index([clinicId, status, lastName, firstName])
}

model Patient {
  id         String           @id @default(uuid()) @db.Uuid
  clinicId   String           @db.Uuid
  name       String           @db.VarChar(100)
  species    Species
  breed      String?          @db.VarChar(100)
  sex        PatientSex       @default(UNKNOWN)
  birthDate  DateTime?         @db.Date
  weightKg   Decimal?         @db.Decimal(8, 3)
  color      String?          @db.VarChar(100)
  microchip  String?          @db.VarChar(64)
  status     PatientStatus    @default(ACTIVE)
  notes      String?          @db.VarChar(2000)
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime         @updatedAt @db.Timestamptz(3)
  clinic     VeterinaryClinic @relation(fields: [clinicId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  tutors     PatientTutor[]

  @@unique([id, clinicId])
  @@unique([clinicId, microchip])
  @@index([clinicId, status, name])
}

// Both composite foreign keys include the same clinicId: cross-clinic links
// are rejected by PostgreSQL even if an application validation is bypassed.
model PatientTutor {
  clinicId  String  @db.Uuid
  patientId String  @db.Uuid
  tutorId   String  @db.Uuid
  patient   Patient @relation(fields: [patientId, clinicId], references: [id, clinicId], onDelete: Restrict, onUpdate: Restrict)
  tutor     Tutor   @relation(fields: [tutorId, clinicId], references: [id, clinicId], onDelete: Restrict, onUpdate: Restrict)

  @@id([clinicId, patientId, tutorId])
  @@index([clinicId, tutorId])
}
