PORT=3001
NODE_ENV=development
SESSION_TTL_SECONDS=28800
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://pawly:CHANGE_ME_LOCAL_ONLY@localhost:5433/pawly?schema=public
# Fijar explícitamente la clínica que administra el sitio público (UUID, sin secreto).
# WEBSITE_CLINIC_ID=
# WEBSITE_PUBLIC_NAME="Clínica Veterinaria Porvenir"
# Local mail capture: docker compose --profile development up -d mailpit
MAIL_MODE=disabled
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# Optional local-only demo tenant, created by scripts/booking-demo.cjs.
# BOOKING_DEMO_CLINIC_ID=
