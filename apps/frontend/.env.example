# URL pública, sin secretos. Usar localhost tanto para frontend como para API.
# En producción con reverse proxy del mismo origen: NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
SITE_URL=http://localhost:3000
# Opcional: origen interno de la API para renderizar el sitio en el servidor.
# WEBSITE_SERVER_API_URL=http://localhost:3001/api
