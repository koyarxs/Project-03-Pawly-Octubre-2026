# URL pública, sin secretos. Usar localhost tanto para frontend como para API.
# En producción con reverse proxy del mismo origen: NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
SITE_URL=http://localhost:3000
# Opcional: origen interno de la API para renderizar el sitio en el servidor.
# WEBSITE_SERVER_API_URL=http://localhost:3001/api

# Opcional: reseñas de la ficha real de Google, solo en el servidor.
# Habilitar Places API (New) en Google Cloud y restringir la clave a esa API.
# Nunca usar NEXT_PUBLIC_ para estas variables ni publicar claves en Git.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
